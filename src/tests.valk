// `valk build . --test`: the world, physics and meshing, without a window

use raylib

// Stone at height `y` over the chunks of a flat world
fn floor(world: World, y: int) {
    let x = -16
    while x < 32 {
        let z = -16
        while z < 32 {
            world.set_block(x, y, z, Block.stone)
            z++
        }
        x++
    }
}

fn near(a: f32, b: f32) bool {
    let d = a - b
    return d < 0.0001 && d > -0.0001
}

fn test_game(creative: bool) Game {
    let world = flat_world()
    floor(world, 9)
    let spawn = raylib.Vector3{ x: 4.5, y: 10, z: 4.5 }
    return Game{ world: world, player: Player.at(spawn), creative: creative, seed: 1, spawn: spawn }
}

fn flat_world() World {
    let world = World.new(1, 2)
    world.mesher.upload = false
    let cz = -1
    while cz <= 1 {
        let cx = -1
        while cx <= 1 {
            world.chunks.set(chunk_key(cx, cz), Chunk{ cx: cx, cz: cz })
            cx++
        }
        cz++
    }
    return world
}

test "Noise: seeded and smooth" {
    let a = Noise.new(42)
    let b = Noise.new(42)
    let c = Noise.new(43)
    assert(a.noise2(1.5, 2.25) == b.noise2(1.5, 2.25))
    assert(a.noise2(1.5, 2.25) != c.noise2(1.5, 2.25))
    assert(a.noise2(3, 7) == 0)
    let x : float = 0
    let low : float = 0
    let high : float = 0
    while x < 50 {
        let v = a.fbm2(x, x * 0.7, 4)
        if v < low : low = v
        if v > high : high = v
        x += 0.37
    }
    assert(low > -1.5 && high < 1.5 && high - low > 0.2)
}

test "Terrain: layers, sea and trees" {
    let terrain = Terrain.new(1337)
    let chunk = Chunk{ cx: 3, cz: -2 }
    terrain.generate(chunk)
    let checked : uint = 0
    each 0 .. 16 as z {
        each 0 .. 16 as x {
            assert(chunk.get(x, 0, z) == Block.bedrock)
            let surface = terrain.height(3 * 16 + x, -2 * 16 + z)
            assert(surface > 0 && surface < WORLD_HEIGHT)
            let top = chunk.get(x, surface, z)
            if top == Block.grass || top == Block.sand || top == Block.snow || top == Block.stone || top == Block.gravel || top == Block.dirt : checked++
            if surface < SEA_LEVEL : assert(chunk.get(x, SEA_LEVEL, z) == Block.water)
            assert(chunk.get(x, WORLD_HEIGHT - 1, z) == Block.air)
        }
    }
    // Only trees and caves change the top block
    assert(checked > 200)

    // The same seed makes the same chunk
    let again = Chunk{ cx: 3, cz: -2 }
    terrain.generate(again)
    let same = true
    each chunk.blocks as block, i {
        if again.blocks[i] != block : same = false
    }
    assert(same)
}

test "Terrain: a tree on a chunk border is whole on both sides" {
    let terrain = Terrain.new(1337)
    // Find a tree whose leaves reach into the next chunk
    let found = false
    let x = 15
    while x < 4000 && !found {
        let z = 0
        while z < 64 && !found {
            if terrain.tree_at(x, z, terrain.height(x, z)) > 0 {
                found = true
                let cx = floor_div(x, 16)
                let cz = floor_div(z, 16)
                let left = Chunk{ cx: cx, cz: cz }
                let right = Chunk{ cx: cx + 1, cz: cz }
                terrain.generate(left)
                terrain.generate(right)
                let leaves_right : uint = 0
                each 0 .. WORLD_HEIGHT as y {
                    each 0 .. 16 as lz {
                        if right.get(0, y, lz) == Block.leaves || right.get(1, y, lz) == Block.leaves : leaves_right++
                    }
                }
                assert(leaves_right > 0)
                let trunk_y = terrain.height(x, z) + 1
                assert(left.get(15, trunk_y, floor_mod(z, 16)) == Block.log)
            }
            z++
        }
        x += 16
    }
    assert(found)
}

test "World: blocks at negative coordinates" {
    let world = flat_world()
    world.set_block(-1, 5, -1, Block.stone)
    world.set_block(0, 5, 0, Block.brick)
    assert(world.block(-1, 5, -1) == Block.stone)
    assert(world.block(0, 5, 0) == Block.brick)
    assert(world.block(-17, 5, 0) == Block.air)
    assert(world.block(0, -1, 0) == Block.bedrock)
    assert(floor_div(-1, 16) == -1 && floor_mod(-1, 16) == 15)
    assert(floor_div(-16, 16) == -1 && floor_mod(-16, 16) == 0)
    assert(floor_div(-17, 16) == -2 && floor_div(15, 16) == 0)
    // Chunks outside the world read as air and take no blocks
    world.set_block(100, 5, 100, Block.stone)
    assert(world.block(100, 5, 100) == Block.air)
}

test "World: an edit on a border marks the neighbour for a new mesh" {
    let world = flat_world()
    each world.chunks as chunk : chunk.dirty = false
    world.set_block(15, 5, 3, Block.stone)
    assert((world.chunk(0, 0) ?? Chunk{ cx: 9, cz: 9 }).dirty)
    assert((world.chunk(1, 0) ?? Chunk{ cx: 9, cz: 9 }).dirty)
    assert(!(world.chunk(-1, 0) ?? Chunk{ cx: 9, cz: 9 }).dirty)
    assert(!(world.chunk(0, 1) ?? Chunk{ cx: 9, cz: 9 }).dirty)
}

test "World: raycasts stop at the first block and name the face" {
    let world = flat_world()
    world.set_block(5, 10, 0, Block.stone)
    let hit = world.raycast(.{ x: 0.5, y: 10.5, z: 0.5 }, .{ x: 1 }, 10) ?! {
        assert(false)
        return
    }
    assert(hit.x == 5 && hit.y == 10 && hit.z == 0)
    assert(hit.normal_x == -1 && hit.normal_y == 0 && hit.normal_z == 0)
    assert(hit.block == Block.stone)
    assert(!isset(world.raycast(.{ x: 0.5, y: 10.5, z: 0.5 }, .{ x: 1 }, 3)))
    // From above, through water
    world.set_block(2, 3, 2, Block.water)
    world.set_block(2, 2, 2, Block.sand)
    let down = world.raycast(.{ x: 2.5, y: 8.5, z: 2.5 }, .{ y: -1 }, 10) ?! {
        assert(false)
        return
    }
    assert(down.y == 2 && down.normal_y == 1 && down.block == Block.sand)
}

test "Player: falls, lands and stops at walls" {
    let world = flat_world()
    floor(world, 9)
    let player = Player.at(.{ x: 4.5, y: 20, z: 4.5 })
    each 0 .. 200 as _ : player.update(world, 1.0 / 60, false)
    assert(player.body.on_ground)
    assert(player.body.position.y == 10)
    // A wall two blocks high at x = 8
    world.set_block(8, 10, 4, Block.stone)
    world.set_block(8, 11, 4, Block.stone)
    each 0 .. 100 as _ : player.body.move_axis(world, 0, 0.1)
    assert(player.body.position.x < 8 - 0.29 && player.body.position.x > 8 - 0.32)
    assert(player.body.overlaps(7, 10, 4))
    assert(!player.body.overlaps(8, 10, 4))
}

test "Mesher: hidden faces are left out" {
    let world = flat_world()
    let chunk = world.chunk(0, 0) ?! {
        assert(false)
        return
    }
    world.set_block(4, 10, 4, Block.stone)
    world.mesher.build(world, chunk)
    // One block: 6 faces of 2 triangles
    assert(chunk.solid.vertex_count == 36)
    world.set_block(5, 10, 4, Block.stone)
    world.mesher.build(world, chunk)
    assert(chunk.solid.vertex_count == 60)
    // Water shows only the faces towards air, and none between water blocks
    world.set_block(10, 10, 10, Block.water)
    world.set_block(11, 10, 10, Block.water)
    world.mesher.build(world, chunk)
    assert(chunk.has_water && chunk.water.vertex_count == 10 * 6)
    // Faces over the chunk border see the neighbour's blocks
    world.set_block(15, 20, 8, Block.stone)
    world.set_block(16, 20, 8, Block.stone)
    world.mesher.build(world, chunk)
    assert(chunk.solid.vertex_count == 60 + 5 * 6)
    chunk.unload_meshes()
}

test "Mesher: corners next to blocks are darker" {
    let world = flat_world()
    let chunk = world.chunk(0, 0) ?! {
        assert(false)
        return
    }
    world.set_block(4, 10, 4, Block.stone)
    world.mesher.build(world, chunk)
    let lone_high, lone_low = brightest_and_darkest(chunk.solid)
    assert(lone_high > lone_low && lone_low > 100)
    // A wall beside the top face shades its near corners
    world.set_block(5, 11, 4, Block.stone)
    world.mesher.build(world, chunk)
    let shaded_high, shaded_low = brightest_and_darkest(chunk.solid)
    assert(shaded_high == lone_high && shaded_low < lone_low)
    chunk.unload_meshes()
}

// The lightest and darkest vertex red channel of a mesh
fn brightest_and_darkest(mesh: raylib.Mesh) (u8, u8) {
    let colors = mesh.colors ?! return (0, 0)
    let high : u8 = 0
    let low : u8 = 255
    let i : uint = 0
    while i < mesh.vertex_count.to(uint) {
        let r = @ptrv(colors.@cast(*[u8]), u8, i * 4)
        if r > high : high = r
        if r < low : low = r
        i++
    }
    return (high, low)
}

test "Crafting: shapes anywhere in the grid, mirrored too" {
    let recipes = all_recipes()
    let grid = Array[Stack].fill(9, .{})
    grid[4] = stack_of(Item.log, 1)
    let planks = craft_result(recipes, grid, 3) ?! {
        assert(false)
        return
    }
    assert(planks.result == Item.planks && planks.count == 4)

    // Sticks: two planks on top of each other, in the corner of a 2x2 grid
    let small = Array[Stack].fill(9, .{})
    small[1] = stack_of(Item.planks, 3)
    small[3] = stack_of(Item.planks, 1)
    let sticks = craft_result(recipes, small, 2) ?! {
        assert(false)
        return
    }
    assert(sticks.result == Item.stick && sticks.count == 4)
    consume_grid(small)
    assert(small[1].count == 2 && is_empty(small[3]))
    assert(!isset(craft_result(recipes, small, 2)))

    // A stone pickaxe: cobblestone on top, two sticks down the middle
    let tool = Array[Stack].fill(9, .{})
    tool[0] = stack_of(Item.cobblestone, 1)
    tool[1] = stack_of(Item.cobblestone, 1)
    tool[2] = stack_of(Item.cobblestone, 1)
    tool[4] = stack_of(Item.stick, 1)
    tool[7] = stack_of(Item.stick, 1)
    assert((craft_result(recipes, tool, 3) ?? planks).result == Item.stone_pickaxe)
    // One wrong ingredient spoils it
    tool[1] = stack_of(Item.planks, 1)
    assert(!isset(craft_result(recipes, tool, 3)))

    // An axe faces either way
    let axe = Array[Stack].fill(9, .{})
    axe[1] = stack_of(Item.iron_ingot, 1)
    axe[2] = stack_of(Item.iron_ingot, 1)
    axe[5] = stack_of(Item.iron_ingot, 1)
    axe[4] = stack_of(Item.stick, 1)
    axe[7] = stack_of(Item.stick, 1)
    assert((craft_result(recipes, axe, 3) ?? planks).result == Item.iron_axe)
}

test "Inventory: stacks fill up, tools do not stack" {
    let inventory = Inventory{}
    assert(is_empty(inventory.add(stack_of(Item.dirt, 50))))
    assert(is_empty(inventory.add(stack_of(Item.dirt, 30))))
    assert(inventory.get(0).count == 64 && inventory.get(1).count == 16)
    assert(inventory.count(Item.dirt) == 80)
    inventory.add(stack_of(Item.wooden_pickaxe, 1))
    inventory.add(stack_of(Item.wooden_pickaxe, 1))
    assert(inventory.get(2).item == Item.wooden_pickaxe && inventory.get(3).item == Item.wooden_pickaxe)
    // Wear breaks the tool at its durability
    inventory.wear(2, 58)
    assert(inventory.get(2).wear == 58)
    inventory.wear(2, 1)
    assert(is_empty(inventory.get(2)))
    inventory.take_one(1)
    assert(inventory.get(1).count == 15)
    // Only into the main slots
    let left = inventory.add_between(stack_of(Item.sand, 64), HOTBAR_SIZE, INVENTORY_SIZE)
    assert(is_empty(left) && inventory.get(HOTBAR_SIZE).item == Item.sand)
    // Full: the rest comes back
    each 0 .. INVENTORY_SIZE as i : inventory.set(i.to(uint), stack_of(Item.stone, 64))
    let rest = inventory.add(stack_of(Item.log, 5))
    assert(rest.item == Item.log && rest.count == 5)
}

test "Mining: the right tool is faster, and some blocks need one" {
    assert(near(break_time(Block.grass, Item.none), 0.9))
    assert(near(break_time(Block.grass, Item.stone_shovel), 0.225))
    // Stone by hand is slow and gives nothing
    assert(near(break_time(Block.stone, Item.none), 7.5))
    assert(!can_harvest(Block.stone, Item.none))
    assert(near(break_time(Block.stone, Item.wooden_pickaxe), 1.125))
    assert(can_harvest(Block.stone, Item.wooden_pickaxe))
    assert(!can_harvest(Block.iron_ore, Item.wooden_pickaxe))
    assert(can_harvest(Block.iron_ore, Item.stone_pickaxe))
    // An axe is no help on stone
    assert(near(break_time(Block.stone, Item.iron_axe), 7.5))
    assert(break_time(Block.bedrock, Item.iron_pickaxe) < 0)
    assert(block_drop(Block.grass, 0) == Item.dirt)
    assert(block_drop(Block.stone, 0) == Item.cobblestone)
    assert(block_drop(Block.glass, 0) == Item.none)
    assert(block_drop(Block.leaves, 3) == Item.stick && block_drop(Block.leaves, 50) == Item.none)
}

test "Game: breaking blocks drops them in survival, not in creative" {
    let game = test_game(false)
    game.world.set_block(6, 10, 6, Block.log)
    game.break_block(6, 10, 6)
    assert(game.world.block(6, 10, 6) == Block.air)
    assert(game.drops.length == 1 && game.drops[0].stack.item == Item.log)
    // Stone with no pickaxe: gone, nothing to pick up
    game.break_block(6, 9, 6)
    assert(game.drops.length == 1)

    let creative = test_game(true)
    creative.world.set_block(6, 10, 6, Block.log)
    creative.break_block(6, 10, 6)
    assert(creative.drops.length == 0)
}

test "Game: items on the ground are picked up" {
    let game = test_game(false)
    game.drops.append(Drop.at(stack_of(Item.beef, 3), .{ x: 5, y: 10, z: 4.5 }, .{}))
    game.drops.append(Drop.at(stack_of(Item.feather, 1), .{ x: 12, y: 10, z: 4.5 }, .{}))
    each 0 .. 60 as _ : game.update_drops(1.0 / 30)
    assert(game.inventory.count(Item.beef) == 3)
    assert(game.inventory.count(Item.feather) == 0 && game.drops.length == 1)
}

test "Game: falls hurt in survival, and dying drops everything" {
    let game = test_game(false)
    game.inventory.add(stack_of(Item.planks, 10))
    game.player = Player.at(.{ x: 4.5, y: 16.5, z: 4.5 })
    each 0 .. 120 as _ : game.update_player(1.0 / 60, false)
    // 6.5 blocks: 3 are free
    assert(game.player.health == 17)
    assert(!game.dead)

    game.player = Player.at(.{ x: 4.5, y: 40, z: 4.5 })
    each 0 .. 240 as _ : game.update_player(1.0 / 60, false)
    assert(game.dead && game.player.health == 0)
    assert(game.death_cause == "fell from a high place")
    assert(game.inventory.count(Item.planks) == 0 && game.drops.length == 1)
    game.respawn()
    assert(!game.dead && game.player.health == MAX_HEALTH)

    let creative = test_game(true)
    creative.player = Player.at(.{ x: 4.5, y: 40, z: 4.5 })
    each 0 .. 240 as _ : creative.update_player(1.0 / 60, false)
    assert(creative.player.health == MAX_HEALTH)
}

test "Animals: they fall, get hurt, die and leave loot" {
    let world = flat_world()
    floor(world, 9)
    let cow = Mob.spawn(MobKind.cow, .{ x: 4.5, y: 14, z: 4.5 })
    each 0 .. 120 as _ : cow.update(world, 1.0 / 60)
    assert(cow.body.on_ground && cow.body.position.y == 10)
    assert(!cow.damage(4, .{ x: 0, y: 10, z: 4.5 }))
    assert(cow.health == 6 && cow.hurt > 0 && cow.panic > 0)
    // Knocked away from the hit
    assert(cow.body.velocity.x > 0)
    assert(cow.damage(6, .{ x: 0, y: 10, z: 4.5 }))
    assert(!cow.alive())
    assert(!cow.damage(6, .{ x: 0, y: 10, z: 4.5 }))

    let loot = mob_loot(MobKind.cow, 99)
    assert(loot[0].item == Item.beef && loot[0].count == 1 && loot[1].item == Item.leather && loot[1].count == 2)
    assert(mob_loot(MobKind.cow, 2)[0].count == 3 && mob_loot(MobKind.cow, 2).length == 1)
    assert(mob_loot(MobKind.sheep, 0)[0].item == Item.wool)
    assert(mob_loot(MobKind.chicken, 0)[0].item == Item.chicken)
    assert(mob_loot(MobKind.pig, 5)[0].item == Item.porkchop)
}

test "Menu: seeds from text" {
    assert(seed_from_text("1234") == 1234)
    assert(seed_from_text(" 42 ") == 42)
    assert(seed_from_text("hello") == seed_from_text("hello"))
    assert(seed_from_text("hello") != seed_from_text("world"))
}

fn test_saves_dir(name: String) String {
    let dir = __DIR__ + "/../debug/test-saves/" + name
    delete_world(dir)
    make_dirs(dir)
    return dir
}

test "Saves: a world comes back as it was left" {
    let dir = test_saves_dir("round-trip")
    let game = test_game(false)
    game.name = "My World"
    game.folder = new_world_folder(dir, game.name)
    game.world.folder = game.folder
    game.created = 1000
    game.world.set_block(3, 12, 5, Block.brick)
    game.world.set_block(-2, 11, -7, Block.planks)
    game.inventory.add(stack_of(Item.stone_pickaxe, 1))
    game.inventory.wear(0, 7)
    game.inventory.set(20, stack_of(Item.cobblestone, 33))
    game.drops.append(Drop.at(stack_of(Item.wool, 2), .{ x: 1.5, y: 10, z: 2.5 }, .{}))
    game.player.body.position = .{ x: 6.5, y: 10, z: 7.5 }
    game.player.yaw = 1.25
    game.player.health = 13
    game.selected = 4
    game.save()
    assert(!(game.world.chunk(0, 0) ?? Chunk{ cx: 9, cz: 9 }).unsaved)

    let worlds = list_worlds(dir)
    assert(worlds.length == 1)
    let info = worlds[0]
    assert(info.name == "My World" && !info.creative && info.seed == 1 && info.created == 1000)
    assert(info.folder.ends_with("my-world"))

    let loaded = Game.load(info, 2)
    loaded.world.mesher.upload = false
    assert(loaded.name == "My World" && loaded.folder == info.folder)
    assert(loaded.player.body.position.x == 6.5 && loaded.player.body.position.z == 7.5)
    assert(loaded.player.yaw == 1.25 && loaded.player.health == 13 && loaded.selected == 4)
    let tool = loaded.inventory.get(0)
    assert(tool.item == Item.stone_pickaxe && tool.wear == 7)
    assert(loaded.inventory.get(20).item == Item.cobblestone && loaded.inventory.get(20).count == 33)
    assert(loaded.drops.length == 1 && loaded.drops[0].stack.item == Item.wool && loaded.drops[0].stack.count == 2)
    // Changed chunks load from disk instead of being generated
    assert(loaded.world.saved.has(chunk_key(0, 0)) && loaded.world.saved.has(chunk_key(-1, -1)))
    loaded.world.update(0, 0, 1000)
    assert(loaded.world.block(3, 12, 5) == Block.brick)
    assert(loaded.world.block(-2, 11, -7) == Block.planks)
    assert(loaded.world.block(3, 9, 5) == Block.stone)

    // A second world with the same name gets a folder of its own
    assert(new_world_folder(dir, "My World").ends_with("my-world-2"))
    let fallback = new_world_folder(dir, "  ?? ")
    assert(fallback.ends_with("world") && !fallback.ends_with("-world"))
    delete_world(info.folder)
    assert(list_worlds(dir).length == 0)
}

test "Player: crouching stays on the edge, and under a low ceiling" {
    let world = flat_world()
    world.set_block(4, 9, 4, Block.stone)
    let player = Player.at(.{ x: 4.5, y: 10, z: 4.5 })
    player.update(world, 1.0 / 60, false)
    assert(player.body.on_ground)
    player.crouch(world, true, 1)
    assert(player.crouching && player.body.height == CROUCH_HEIGHT)
    // Walking off the only block: the edge holds
    player.body.edge_guard = true
    each 0 .. 20 as _ : player.body.move_axis(world, 0, 0.1)
    assert(player.body.position.x < 5.3 && player.body.position.x > 4.9)
    player.body.edge_guard = false
    each 0 .. 20 as _ : player.body.move_axis(world, 0, 0.1)
    assert(player.body.position.x > 6)

    // A ceiling 1.6 blocks up keeps the player down
    let low = flat_world()
    low.set_block(2, 9, 2, Block.stone)
    low.set_block(2, 11, 2, Block.stone)
    let under = Player.at(.{ x: 2.5, y: 10, z: 2.5 })
    under.crouch(low, true, 1)
    under.crouch(low, false, 1)
    assert(under.crouching)
    under.body.position.x = 3.5
    under.crouch(low, false, 1)
    assert(!under.crouching && under.body.height == PLAYER_HEIGHT)
}

test "Game: switching to survival mid-air starts a fall there" {
    let game = test_game(true)
    game.player = Player.at(.{ x: 4.5, y: 30, z: 4.5 })
    game.player.flying = true
    game.set_creative(false)
    assert(!game.creative && !game.player.flying && game.player.fall_top == 30)
    assert(game.message == "Game mode: Survival")
    each 0 .. 240 as _ : game.update_player(1.0 / 60, false)
    // 20 blocks: 17 damage
    assert(game.player.health == 3)
}
