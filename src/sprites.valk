// Pixel art for the items that are not blocks, and the hearts and bubbles of the HUD.
// Each sprite is 16 rows of text; its palette says what color each letter is.

use raylib

value SPRITE_COLUMNS (8)
value SPRITE_STICK (0)
value SPRITE_INGOT (1)
value SPRITE_LEATHER (2)
value SPRITE_FEATHER (3)
value SPRITE_PORKCHOP (4)
value SPRITE_BEEF (5)
value SPRITE_MUTTON (6)
value SPRITE_CHICKEN (7)
// Pickaxe, axe, shovel, sword, each in wood, stone and iron: 8 + tool * 3 + tier
value SPRITE_TOOLS (8)
value SPRITE_HEART (20)
value SPRITE_HALF_HEART (21)
value SPRITE_EMPTY_HEART (22)
value SPRITE_BUBBLE (23)

fn item_sprite(item: Item) uint {
    let tool = item_tool(item)
    if tool != Tool.none {
        let index : uint = tool == Tool.pickaxe ? 0 : (tool == Tool.axe ? 1 : (tool == Tool.shovel ? 2 : 3))
        return SPRITE_TOOLS + index * 3 + item_tier(item) - 1
    }
    match item {
        Item.stick => return SPRITE_STICK
        Item.iron_ingot => return SPRITE_INGOT
        Item.leather => return SPRITE_LEATHER
        Item.feather => return SPRITE_FEATHER
        Item.porkchop => return SPRITE_PORKCHOP
        Item.beef => return SPRITE_BEEF
        Item.mutton => return SPRITE_MUTTON
        Item.chicken => return SPRITE_CHICKEN
        default => return SPRITE_STICK
    }
}

// Pulled in a hair, so scaling never samples the sprite next to it
fn sprite_rectangle(sprite: uint) raylib.Rectangle {
    let inset : f32 = 0.02
    return raylib.Rectangle{ x: ((sprite % SPRITE_COLUMNS) * 16).to(f32) + inset, y: ((sprite / SPRITE_COLUMNS) * 16).to(f32) + inset, width: 16 - inset * 2, height: 16 - inset * 2 }
}

class SpritePainter {
    image: raylib.Image
    letters: String ("")
    colors: Array[raylib.Color] (.{})

    fn color(letter: u8, color: raylib.Color) {
        let buf = ByteBuffer.new(this.letters.bytes + 1)
        buf.write(this.letters)
        buf.write_byte(letter)
        this.letters = buf.to_string()
        this.colors.append(color)
    }

    fn paint(sprite: uint, rows: Array[String]) {
        let x0 = ((sprite % SPRITE_COLUMNS) * 16).to(i32)
        let y0 = ((sprite / SPRITE_COLUMNS) * 16).to(i32)
        each rows as row, y {
            each row as letter, x {
                each this.colors as color, i {
                    if this.letters[i] == letter : this.image.draw_pixel(x0 + x.to(i32), y0 + y.to(i32), color)
                }
            }
        }
    }

    fn reset() {
        this.letters = ""
        this.colors.clear()
        this.color('k', raylib.Color.rgb(38, 28, 18))
        this.color('w', raylib.Color.rgb(112, 80, 40))
        this.color('W', raylib.Color.rgb(156, 116, 62))
    }
}

fn pickaxe_rows() Array[String] {
    return Array[String]{
        "................"
        "...kkkkkkkk....."
        "..kMMMMMMMMk...."
        "..kmmkkkkmmdk..."
        "...kk..kwkkmdk.."
        "......kwk..kmdk."
        ".....kwk....kdk."
        "....kwk......kk."
        "...kwk.........."
        "..kwk..........."
        ".kwk............"
        ".kk............."
        "................"
        "................"
        "................"
        "................"
    }
}

fn axe_rows() Array[String] {
    return Array[String]{
        "................"
        "........kkk....."
        ".......kMMMk...."
        "......kMmmmdk..."
        "......kMmmmmdk.."
        ".......kmmwkdk.."
        "........kwkkk..."
        ".......kwk......"
        "......kwk......."
        ".....kwk........"
        "....kwk........."
        "...kwk.........."
        "..kwk..........."
        "..kk............"
        "................"
        "................"
    }
}

fn shovel_rows() Array[String] {
    return Array[String]{
        "................"
        "..........kkk..."
        ".........kMMMk.."
        "........kMmmmdk."
        "........kmmmmdk."
        ".........kmddk.."
        "........kwkkk..."
        ".......kwk......"
        "......kwk......."
        ".....kwk........"
        "....kwk........."
        "...kwk.........."
        "..kwk..........."
        "..kk............"
        "................"
        "................"
    }
}

fn sword_rows() Array[String] {
    return Array[String]{
        "................"
        ".............kk."
        "............kMMk"
        "...........kMmdk"
        "..........kMmdk."
        ".........kMmdk.."
        "........kMmdk..."
        ".......kMmdk...."
        "..kk..kMmdk....."
        "..kdkkMmdk......"
        "...kdMmdk......."
        "...kmddk........"
        "..kwkkdk........"
        ".kwk..kk........"
        ".kk............."
        "................"
    }
}

fn meat_rows() Array[String] {
    return Array[String]{
        "................"
        "................"
        "................"
        ".....kkkkk......"
        "....kRRRRRkk...."
        "...kRrrrrrRRk..."
        "..kRrrrrrrrrRk.."
        "..krrrrrrrrrrk.."
        "..krrrffrrrrrk.."
        "..krrrfffrrrrk.."
        "...krrrrrrrrk..."
        "....kkrrrrrk...."
        "......kkkkk....."
        "................"
        "................"
        "................"
    }
}

fn build_sprites() raylib.Texture {
    let image = raylib.gen_image_color((SPRITE_COLUMNS * 16).to(i32), 48, raylib.BLANK)
    let p = SpritePainter{ image: image }

    p.reset()
    p.paint(SPRITE_STICK, Array[String]{
        "................"
        "................"
        "............kk.."
        "...........kWk.."
        "..........kwk..."
        ".........kwk...."
        "........kwk....."
        ".......kwk......"
        "......kwk......."
        ".....kwk........"
        "....kwk........."
        "...kWk.........."
        "...kk..........."
        "................"
        "................"
        "................"
    })

    p.reset()
    p.color('M', raylib.Color.rgb(245, 245, 245))
    p.color('m', raylib.Color.rgb(212, 212, 212))
    p.color('d', raylib.Color.rgb(150, 150, 150))
    p.paint(SPRITE_INGOT, Array[String]{
        "................"
        "................"
        "................"
        "................"
        "................"
        ".....kkkkkkkk..."
        "....kMMMMMMMMk.."
        "...kMmmmmmmmdk.."
        "..kMmmmmmmmdk..."
        "..kddddddddk...."
        "..kkkkkkkkkk...."
        "................"
        "................"
        "................"
        "................"
        "................"
    })

    p.reset()
    p.color('L', raylib.Color.rgb(170, 100, 55))
    p.color('l', raylib.Color.rgb(135, 75, 40))
    p.paint(SPRITE_LEATHER, Array[String]{
        "................"
        "................"
        "...kkkkkkkkkk..."
        "..kLLLLLLLLLLk.."
        "..kLllllllllLk.."
        "..kLlllllllllk.."
        "...klllllllllk.."
        "...kllllllllk..."
        "..kLllllllllk..."
        "..kllllllllllk.."
        "..klllllllllLk.."
        "...kkkkkkkkkk..."
        "................"
        "................"
        "................"
        "................"
    })

    p.reset()
    p.color('F', raylib.Color.rgb(250, 250, 250))
    p.color('f', raylib.Color.rgb(205, 205, 210))
    p.color('g', raylib.Color.rgb(120, 120, 120))
    p.paint(SPRITE_FEATHER, Array[String]{
        "................"
        "............kk.."
        "...........kFk.."
        "..........kFFk.."
        ".........kFFfk.."
        "........kFFfk..."
        ".......kFFfk...."
        "......kFFfk....."
        ".....kFFfk......"
        "....kFfk........"
        "...kfk.........."
        "..kgk..........."
        ".kgk............"
        ".kk............."
        "................"
        "................"
    })

    let meats = Array[uint]{ SPRITE_PORKCHOP, SPRITE_BEEF, SPRITE_MUTTON, SPRITE_CHICKEN }
    let light = Array[raylib.Color]{ raylib.Color.rgb(246, 168, 168), raylib.Color.rgb(214, 80, 72), raylib.Color.rgb(222, 110, 100), raylib.Color.rgb(250, 214, 186) }
    let dark = Array[raylib.Color]{ raylib.Color.rgb(222, 120, 124), raylib.Color.rgb(166, 44, 40), raylib.Color.rgb(184, 70, 66), raylib.Color.rgb(226, 176, 146) }
    each meats as sprite, i {
        p.reset()
        p.color('R', light[i])
        p.color('r', dark[i])
        p.color('f', raylib.Color.rgb(250, 240, 230))
        p.paint(sprite, meat_rows())
    }

    // Tool heads in wood, stone and iron
    let tier_light = Array[raylib.Color]{ raylib.Color.rgb(196, 156, 92), raylib.Color.rgb(172, 172, 172), raylib.Color.rgb(246, 246, 246) }
    let tier_mid = Array[raylib.Color]{ raylib.Color.rgb(156, 118, 62), raylib.Color.rgb(132, 132, 132), raylib.Color.rgb(208, 208, 208) }
    let tier_dark = Array[raylib.Color]{ raylib.Color.rgb(104, 76, 40), raylib.Color.rgb(92, 92, 92), raylib.Color.rgb(150, 150, 150) }
    let shapes = Array[Array[String]]{ pickaxe_rows(), axe_rows(), shovel_rows(), sword_rows() }
    each shapes as rows, tool {
        each 0 .. 3 as tier {
            p.reset()
            p.color('M', tier_light[tier.to(uint)])
            p.color('m', tier_mid[tier.to(uint)])
            p.color('d', tier_dark[tier.to(uint)])
            p.paint(SPRITE_TOOLS + tool * 3 + tier.to(uint), rows)
        }
    }

    let heart = Array[String]{
        ".kk.kk."
        "kwRkRRk"
        "kRRRRRk"
        "kRRRRRk"
        ".kRRRk."
        "..kRk.."
        "...k..."
    }
    p.reset()
    p.color('R', raylib.Color.rgb(220, 30, 30))
    p.color('w', raylib.Color.rgb(255, 170, 170))
    p.paint(SPRITE_HEART, heart)
    p.reset()
    p.color('R', raylib.Color.rgb(60, 20, 20))
    p.color('w', raylib.Color.rgb(60, 20, 20))
    p.paint(SPRITE_EMPTY_HEART, heart)
    p.paint(SPRITE_HALF_HEART, heart)
    p.reset()
    p.color('R', raylib.Color.rgb(220, 30, 30))
    p.color('w', raylib.Color.rgb(255, 170, 170))
    p.paint(SPRITE_HALF_HEART, Array[String]{
        ".kk...."
        "kwRk..."
        "kRRR..."
        "kRRR..."
        ".kRR..."
        "..kR..."
        "...k..."
    })

    p.reset()
    p.color('b', raylib.Color.rgb(90, 150, 240))
    p.color('B', raylib.Color.rgb(200, 230, 255))
    p.paint(SPRITE_BUBBLE, Array[String]{
        ".kkk."
        "kBbbk"
        "kbbbk"
        "kbbbk"
        ".kkk."
    })

    let texture = raylib.load_texture_from_image(p.image)
    raylib.unload_image(p.image)
    raylib.set_texture_filter(texture, .point)
    return texture
}
