// What is drawn over the world: crosshair, hotbar, and the text in the corners

use raylib
use valk.math

fn draw_crosshair() {
    let cx = raylib.get_screen_width() / 2
    let cy = raylib.get_screen_height() / 2
    let color = raylib.Color.rgba(255, 255, 255, 220)
    raylib.draw_rectangle(cx - 10, cy - 1, 20, 2, color)
    raylib.draw_rectangle(cx - 1, cy - 10, 2, 20, color)
}

fn draw_hotbar(atlas: raylib.Texture, selected: uint) {
    let blocks = hotbar_blocks()
    let slot : i32 = 52
    let gap : i32 = 4
    let width = blocks.length.to(i32) * (slot + gap) - gap
    let x0 = (raylib.get_screen_width() - width) / 2
    let y = raylib.get_screen_height() - slot - 14
    raylib.draw_rectangle(x0 - 6, y - 6, width + 12, slot + 12, raylib.Color.rgba(0, 0, 0, 110))
    each blocks as block, i {
        let x = x0 + i.to(i32) * (slot + gap)
        let active = i == selected
        raylib.draw_rectangle(x, y, slot, slot, raylib.Color.rgba(30, 30, 30, active ? 200 : 140))
        let icon = raylib.Rectangle{ x: (x + 8).to(f32), y: (y + 8).to(f32), width: (slot - 16).to(f32), height: (slot - 16).to(f32) }
        raylib.draw_texture_pro(atlas, tile_rectangle(block_tile(block, 0)), icon, .{}, 0, raylib.WHITE)
        raylib.draw_rectangle_lines_ex(raylib.Rectangle{ x: x.to(f32), y: y.to(f32), width: slot.to(f32), height: slot.to(f32) }, active ? 3 : 1, active ? raylib.WHITE : raylib.Color.rgba(120, 120, 120, 255))
        raylib.draw_text("" + (i + 1), x + 4, y + 3, 10, raylib.Color.rgba(255, 255, 255, 180))
    }
    let name = block_name(blocks[selected])
    let w = raylib.measure_text(name, 20)
    raylib.draw_text(name, (raylib.get_screen_width() - w) / 2, y - 34, 20, raylib.WHITE)
}

fn draw_text_shadowed(text: String, x: i32, y: i32, size: i32, color: raylib.Color) {
    raylib.draw_text(text, x + 2, y + 2, size, raylib.Color.rgba(0, 0, 0, 150))
    raylib.draw_text(text, x, y, size, color)
}

fn draw_info(player: Player, world: World, target: ?RayHit) {
    let p = player.position
    draw_text_shadowed("Valkcraft", 14, 12, 28, raylib.WHITE)
    draw_text_shadowed(raylib.get_fps() + " fps   " + world.chunks.length + " chunks", 14, 46, 18, raylib.Color.rgb(230, 230, 230))
    let position = "x " + whole(p.x) + "  y " + whole(p.y) + "  z " + whole(p.z)
    draw_text_shadowed(position, 14, 68, 18, raylib.Color.rgb(230, 230, 230))
    let mode = player.flying ? "flying (F)" : (player.in_water ? "swimming" : "walking")
    draw_text_shadowed(mode, 14, 90, 18, raylib.Color.rgb(230, 230, 230))
    if isset(target) {
        draw_text_shadowed("looking at " + block_name(target.block), 14, 112, 18, raylib.Color.rgb(230, 230, 230))
    }
}

fn draw_help() {
    let lines = Array[String]{
        "WASD  move      Space  jump / swim up",
        "Mouse  look     Ctrl or R  sprint",
        "Left click  break    Right click  place",
        "1-9 or wheel  pick a block",
        "F  fly (Space up, Shift down)",
        "F2  screenshot    Esc  free the mouse",
        "H  hide this",
    }
    let y : i32 = 12
    each lines as line {
        let w = raylib.measure_text(line, 16)
        draw_text_shadowed(line, raylib.get_screen_width() - w - 14, y, 16, raylib.Color.rgb(235, 235, 235))
        y += 20
    }
}

fn draw_paused() {
    let w = raylib.get_screen_width()
    let h = raylib.get_screen_height()
    raylib.draw_rectangle(0, 0, w, h, raylib.Color.rgba(0, 0, 0, 120))
    let title = "Paused"
    raylib.draw_text(title, (w - raylib.measure_text(title, 48)) / 2, h / 2 - 50, 48, raylib.WHITE)
    let hint = "Click to play"
    raylib.draw_text(hint, (w - raylib.measure_text(hint, 22)) / 2, h / 2 + 10, 22, raylib.Color.rgb(220, 220, 220))
}

fn draw_loading(done: uint, total: uint) {
    let w = raylib.get_screen_width()
    let h = raylib.get_screen_height()
    let text = "Generating the world..."
    raylib.draw_text(text, (w - raylib.measure_text(text, 30)) / 2, h / 2 - 40, 30, raylib.WHITE)
    let bar : i32 = 360
    let filled : i32 = total == 0 ? 0 : (bar.to(uint) * done / total).to(i32)
    raylib.draw_rectangle((w - bar) / 2, h / 2 + 10, bar, 14, raylib.Color.rgba(255, 255, 255, 60))
    raylib.draw_rectangle((w - bar) / 2, h / 2 + 10, filled, 14, raylib.Color.rgb(120, 200, 90))
}

fn whole(value: f32) String {
    return math.floor(value).to(int).to_string()
}
