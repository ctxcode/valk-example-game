// What is drawn over the world while playing: crosshair, hotbar, hearts, text

use raylib
use valk.math

fn draw_crosshair() {
    let cx = screen_width() / 2
    let cy = screen_height() / 2
    let color = raylib.Color.rgba(255, 255, 255, 220)
    raylib.draw_rectangle(cx - 10, cy - 1, 20, 2, color)
    raylib.draw_rectangle(cx - 1, cy - 10, 2, 20, color)
}

fn hotbar_left() i32 {
    return (screen_width() - HOTBAR_SIZE * 54) / 2
}

fn draw_hotbar(ui: Ui, game: Game) {
    let slot : i32 = 50
    let step : i32 = 54
    let x0 = hotbar_left()
    let y = screen_height() - slot - 12
    raylib.draw_rectangle(x0 - 6, y - 6, HOTBAR_SIZE * step + 8, slot + 12, raylib.Color.rgba(0, 0, 0, 120))
    each 0 .. HOTBAR_SIZE as i {
        let x = x0 + i.to(i32) * step
        let active = i.to(uint) == game.selected
        raylib.draw_rectangle(x, y, slot, slot, raylib.Color.rgba(40, 40, 40, active ? 210 : 150))
        ui.stack(game.inventory.get(i.to(uint)), x.to(f32), y.to(f32), slot.to(f32))
        raylib.draw_rectangle_lines_ex(raylib.Rectangle{ x: x.to(f32) - 2, y: y.to(f32) - 2, width: (slot + 4).to(f32), height: (slot + 4).to(f32) }, active ? 3 : 1, active ? raylib.WHITE : raylib.Color.rgba(120, 120, 120, 200))
    }
    let held = game.held()
    if !is_empty(held) {
        let name = item_name(held.item)
        text_centered_shadowed(name, screen_width() / 2, y - (game.creative ? 34 : 70), 20, raylib.WHITE)
    }
}

// Ten hearts and, under water, ten bubbles above the hotbar
fn draw_health(res: Resources, game: Game) {
    let player = game.player
    let size : f32 = 21
    let x0 = hotbar_left().to(f32)
    let y = (screen_height() - 50 - 12 - 32).to(f32)
    each 0 .. 10 as i {
        let x = x0 + i.to(f32) * (size + 2)
        let points = player.health - (i * 2).to(f32)
        let sprite = points >= 2 ? SPRITE_HEART : (points >= 1 ? SPRITE_HALF_HEART : SPRITE_EMPTY_HEART)
        // Hearts shake when low
        let shake : f32 = player.health <= 4 ? (raylib.get_random_value(-1, 1)).to(f32) : 0
        res.draw_sprite(sprite, x, y + shake, size, size, 7, 7)
    }
    if player.breath < MAX_BREATH {
        let bubbles = (player.breath + 0.99).to(int)
        let right = x0 + HOTBAR_SIZE * 54
        each 0 .. bubbles as i {
            res.draw_sprite(SPRITE_BUBBLE, right - (i + 1).to(f32) * 22, y, 18, 18, 5, 5)
        }
    }
}

fn draw_info(game: Game) {
    let p = game.player.body.position
    let light = raylib.Color.rgb(230, 230, 230)
    text_shadowed("Valkcraft", 14, 12, 28, raylib.WHITE)
    text_shadowed(raylib.get_fps() + " fps   " + game.world.chunks.length + " chunks   " + game.mobs.length + " animals", 14, 46, 18, light)
    text_shadowed("x " + whole(p.x) + "  y " + whole(p.y) + "  z " + whole(p.z), 14, 68, 18, light)
    let mode = game.creative ? "creative" : "survival"
    let moving = game.player.flying ? "flying" : (game.player.in_water ? "swimming" : (game.player.crouching ? "crouching" : "walking"))
    text_shadowed(game.name + ": " + mode + ", " + moving, 14, 90, 18, light)
    let target = game.target
    let mob = game.target_mob
    if isset(mob) {
        let names = Array[String]{ "Pig", "Cow", "Sheep", "Chicken" }
        text_shadowed(names[mob_kind_index(mob.kind)] + "  " + whole(mob.health) + " / " + whole(mob_health(mob.kind)), 14, 112, 18, light)
    } else if isset(target) {
        text_shadowed(item_name(block_item(target.block)), 14, 112, 18, light)
    }
}

fn draw_help(creative: bool) {
    let lines = Array[String]{
        "WASD  move      Space  jump / swim up",
        "Mouse  look     Shift  sprint    Ctrl  crouch",
        "Left  break / hit    Right  place / eat / use",
        "1-9 or wheel  pick    E  inventory    Q  drop",
        creative ? "F  fly (Space up, Ctrl down)" : "Right click a crafting table for 3x3",
        "F4  creative / survival    F2  screenshot",
        "Esc  menu    H  hide this",
    }
    let y : i32 = 12
    each lines as line {
        let w = raylib.measure_text(line, 16)
        text_shadowed(line, screen_width() - w - 14, y, 16, raylib.Color.rgb(235, 235, 235))
        y += 20
    }
}

fn draw_message(game: Game) {
    if game.message_time <= 0 : return
    let alpha = game.message_time > 0.5 ? 255 : (game.message_time * 2 * 255).to(int)
    text_centered_shadowed(game.message, screen_width() / 2, screen_height() / 2 - 120, 24, raylib.Color.rgba(255, 255, 255, alpha.to(u8)))
}

fn draw_overlays(game: Game, camera: raylib.Camera3D) {
    let w = screen_width()
    let h = screen_height()
    let eye = camera.position
    if game.world.block(math.floor(eye.x).to(int), math.floor(eye.y).to(int), math.floor(eye.z).to(int)) == Block.water {
        raylib.draw_rectangle(0, 0, w, h, raylib.Color.rgba(30, 70, 180, 100))
    }
    if game.player.hurt > 0 {
        let alpha = (game.player.hurt / 0.35 * 110).to(u8)
        raylib.draw_rectangle(0, 0, w, h, raylib.Color.rgba(200, 0, 0, alpha))
    }
}

fn draw_loading(done: uint, total: uint) {
    let w = screen_width()
    let h = screen_height()
    raylib.clear_background(raylib.Color.rgb(46, 34, 26))
    text_centered_shadowed("Generating the world...", w / 2, h / 2 - 40, 30, raylib.WHITE)
    let bar : i32 = 360
    let filled : i32 = total == 0 ? 0 : (bar.to(uint) * done / total).to(i32)
    raylib.draw_rectangle((w - bar) / 2, h / 2 + 10, bar, 14, raylib.Color.rgba(255, 255, 255, 60))
    raylib.draw_rectangle((w - bar) / 2, h / 2 + 10, filled, 14, raylib.Color.rgb(120, 200, 90))
}
