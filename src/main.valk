// Valkcraft: a small Minecraft-like game, made with Valk and raylib

use raylib
use valk.math

enum Screen : u8 {
    title
    worlds
    delete
    create
    loading
    playing
    paused
    inventory
    dead
}

class Options {
    seed: ?uint (null)
    creative: bool (false)
    distance: int (8)
    width: i32 (1280)
    height: i32 (720)
    // Skip the menus and start a world right away
    play: bool (false)
    // Save one frame to this file once the world is loaded, then quit
    screenshot: String ("")
    // The screenshot is of the title screen, or of the inventory
    title: bool (false)
    inventory: bool (false)
    hud: bool (false)
    // Start with some blocks and tools, to try things out
    kit: bool (false)
    // One of each animal in front of the player
    animals: bool (false)
    // Where worlds are saved; the user's data folder when empty
    saves: String ("")
    // The screenshot is of the world list
    worlds: bool (false)
    // Play this many frames once loaded, print the frame rate and quit
    frames: int (0)
    // Where to start and where to look, in degrees
    at_x: ?int (null)
    at_z: ?int (null)
    up: int (0)
    yaw: ?f32 (null)
    pitch: ?f32 (null)
}

fn parse_options(args: Array[String]) Options {
    let o = Options{}
    let i : uint = 1
    while i < args.length {
        let arg = args[i]
        let next = i + 1 < args.length ? args[i + 1] : ""
        let takes = true
        if arg == "--seed" {
            o.seed = seed_from_text(next)
            o.play = true
        } else if arg == "--distance" {
            o.distance = next.to(int) !? o.distance
            if o.distance < 2 : o.distance = 2
            if o.distance > 24 : o.distance = 24
        } else if arg == "--size" {
            let parts = next.split("x")
            if parts.length == 2 {
                o.width = parts[0].to(i32) !? o.width
                o.height = parts[1].to(i32) !? o.height
            }
        } else if arg == "--screenshot" {
            o.screenshot = next
        } else if arg == "--at" {
            let parts = next.split(",")
            if parts.length == 2 {
                o.at_x = parts[0].to(int) !? null
                o.at_z = parts[1].to(int) !? null
            }
        } else if arg == "--saves" {
            o.saves = next
        } else if arg == "--frames" {
            o.frames = next.to(int) !? 0
            o.play = true
        } else if arg == "--up" {
            o.up = next.to(int) !? 0
        } else if arg == "--yaw" {
            o.yaw = next.to(f32) !? null
        } else if arg == "--pitch" {
            o.pitch = next.to(f32) !? null
        } else {
            takes = false
            if arg == "--creative" : o.creative = true
            else if arg == "--play" : o.play = true
            else if arg == "--title" : o.title = true
            else if arg == "--worlds" : o.worlds = true
            else if arg == "--inventory" : o.inventory = true
            else if arg == "--hud" : o.hud = true
            else if arg == "--kit" : o.kit = true
            else if arg == "--animals" : o.animals = true
            else if arg == "--help" || arg == "-h" {
                println("valkcraft [--saves DIR] [--seed TEXT] [--creative] [--play] [--distance CHUNKS] [--size WxH]")
                println("          [--screenshot FILE [--title] [--worlds] [--inventory] [--hud]] [--kit] [--animals] [--at X,Z] [--up N] [--yaw DEG] [--pitch DEG]")
                exit(0)
            }
        }
        if takes : i++
        i++
    }
    if o.screenshot.bytes > 0 && !o.title && !o.worlds {
        o.play = true
        // The same world every time, unless asked otherwise
        if !isset(o.seed) : o.seed = 1337
    }
    return o
}

class App {
    res: Resources
    ui: Ui
    options: Options
    screen: Screen (Screen.title)
    clouds: Clouds
    game: ?Game (null)
    // The world behind the menus
    panorama: ?World (null)
    time: f32 (0)
    // The world list, and the new world screen
    saves: String
    worlds: Array[WorldInfo] (.{})
    selected: uint (0)
    name_text: String ("New World")
    seed_text: String ("")
    focus: Field (Field.name)
    creative: bool (false)
    show_help: bool (true)
    screenshots: int (0)
    // Frames to ignore the mouse after it is captured, so the view does not jump
    settle: int (0)
    bench_frames: int (0)
    bench_time: f32 (0)
    quit: bool (false)

    fn go(screen: Screen) {
        let playing = screen == Screen.playing
        let game = this.game
        if playing && this.screen != Screen.playing && isset(game) : game.mouse_blocked = true
        if playing && raylib.is_cursor_hidden() == false {
            raylib.disable_cursor()
            this.settle = 2
        }
        if !playing && raylib.is_cursor_hidden() : raylib.enable_cursor()
        this.screen = screen
    }

    fn close_panorama() {
        let panorama = this.panorama
        if isset(panorama) {
            panorama.unload()
            this.panorama = null
        }
    }

    // A new world; saved right away unless it is only for a screenshot or a benchmark
    fn start_game(name: String, seed: uint, creative: bool) {
        this.close_panorama()
        let game = Game.new(seed, creative, this.options.distance)
        let o = this.options
        game.name = name.trim(" ").bytes > 0 ? name.trim(" ") : "New World"
        game.created = now_seconds()
        if o.screenshot.bytes == 0 && o.frames <= 0 {
            game.folder = new_world_folder(this.saves, game.name)
            game.world.folder = game.folder
        }
        let at_x = o.at_x
        let at_z = o.at_z
        if isset(at_x) && isset(at_z) {
            let height = game.world.terrain.height(at_x, at_z)
            if height < SEA_LEVEL : height = SEA_LEVEL
            game.player = Player.at(.{ x: at_x.to(f32) + 0.5, y: (height + 1).to(f32), z: at_z.to(f32) + 0.5 })
        }
        if o.up > 0 {
            // Creative players hover there; the others fall
            game.player.body.position.y += o.up.to(f32)
            game.player.fall_top = game.player.body.position.y
            game.player.flying = creative
        }
        let yaw = o.yaw
        let pitch = o.pitch
        if isset(yaw) : game.player.yaw = yaw * raylib.DEG2RAD
        if isset(pitch) : game.player.pitch = pitch * raylib.DEG2RAD
        if o.kit : give_kit(game)
        if o.animals {
            // One of each, in a row in front of the player
            let p = game.player.body.position
            let forward = game.player.forward()
            let side = raylib.Vector3{ x: -forward.z, z: forward.x }.normalize()
            each 0 .. 4 as i {
                let at = p + raylib.Vector3{ x: forward.x, z: forward.z }.normalize().scale(3) + side.scale((i.to(f32) - 1) * 1.8)
                let mob = Mob.spawn(mob_kind_of(i.to(uint)), at)
                mob.yaw = game.player.yaw + 3.1416 + 0.6
                mob.heading = mob.yaw
                mob.timer = 100
                game.mobs.append(mob)
            }
        }
        game.save()
        this.play(game)
    }

    fn load_world(info: WorldInfo) {
        this.close_panorama()
        this.play(Game.load(info, this.options.distance))
    }

    fn play(game: Game) {
        this.game = game
        let view = (this.options.distance * CHUNK_SIZE).to(f32)
        this.res.set_fog(sky_color(), view * 0.55, view * 0.95)
        this.go(Screen.loading)
    }

    // Saves what is being played, e.g. before quitting
    fn save_game() {
        let game = this.game ?! return
        game.return_grid()
        game.save()
    }

    fn to_title() {
        let game = this.game
        if isset(game) {
            this.save_game()
            game.unload()
            this.game = null
        }
        this.go(Screen.title)
    }

    fn open_worlds() {
        this.worlds = list_worlds(this.saves)
        this.selected = 0
        this.screen = Screen.worlds
    }

    fn panorama_world() World {
        let existing = this.panorama
        if isset(existing) : return existing
        let world = World.new(1337, 7)
        this.panorama = world
        this.res.set_fog(sky_color(), 7 * 16 * 0.55, 7 * 16 * 0.95)
        return world
    }

    fn frame(dt: f32) {
        this.time += dt
        this.ui.begin()
        let screen = this.screen
        if screen == Screen.title || screen == Screen.worlds || screen == Screen.delete || screen == Screen.create {
            this.menu_frame(dt)
            return
        }
        let game = this.game ?! {
            this.go(Screen.title)
            return
        }
        if screen == Screen.loading {
            let p = game.player.body.position
            let cx = floor_div(math.floor(p.x).to(int), CHUNK_SIZE)
            let cz = floor_div(math.floor(p.z).to(int), CHUNK_SIZE)
            let ready = game.world.update(cx, cz, 24)
            raylib.begin_drawing()
            let done, total = game.world.progress(cx, cz)
            draw_loading(done, total)
            raylib.end_drawing()
            if ready {
                game.update(0, false)
                if this.options.inventory {
                    this.go(Screen.inventory)
                } else {
                    this.go(Screen.playing)
                }
            }
            return
        }
        this.game_frame(game, dt)
    }

    fn menu_frame(dt: f32) {
        let world = this.panorama_world()
        // The camera turns slowly over an island
        let center = raylib.Vector3{ x: -260, y: (world.terrain.height(-260, -700) + 22).to(f32), z: -700 }
        let angle = this.time * 0.04 - 1.4
        let camera = raylib.Camera3D{
            position: center
            target: center + raylib.Vector3{ x: math.cos(angle).to(f32), y: -0.28, z: math.sin(angle).to(f32) }
            up: .{ y: 1 }
            fovy: 70
        }
        world.update(floor_div(-260, CHUNK_SIZE), floor_div(-700, CHUNK_SIZE), 6)
        world.fresh.clear()

        raylib.begin_drawing()
        raylib.clear_background(sky_color())
        this.res.shader.set_vec3(this.res.view_location, camera.position)
        raylib.begin_mode_3d(camera)
        this.res.set_tint(raylib.WHITE)
        world.draw(this.res.material, camera)
        this.clouds.draw(camera, this.time, 7 * 16 * 1.3)
        raylib.end_mode_3d()

        let screen = this.screen
        if screen == Screen.title {
            let action = title_screen(this.ui, this.time)
            if action == MenuAction.open_worlds : this.open_worlds()
            if action == MenuAction.quit : this.quit = true
        } else if screen == Screen.worlds {
            let action, selected = worlds_screen(this.ui, this.worlds, this.selected, this.scroll())
            this.selected = selected
            if action == MenuAction.back : this.screen = Screen.title
            if action == MenuAction.delete : this.screen = Screen.delete
            if action == MenuAction.open_create {
                this.name_text = "New World"
                this.seed_text = ""
                this.focus = Field.name
                this.screen = Screen.create
            }
            if action == MenuAction.play {
                raylib.end_drawing()
                this.load_world(this.worlds[this.selected])
                return
            }
        } else if screen == Screen.delete {
            let action = delete_screen(this.ui, this.worlds[this.selected])
            if action == MenuAction.confirm {
                delete_world(this.worlds[this.selected].folder)
                this.open_worlds()
            }
            if action == MenuAction.back : this.screen = Screen.worlds
        } else {
            this.type_text()
            let action, focus = create_screen(this.ui, this.name_text, this.seed_text, this.focus, this.creative, this.time)
            this.focus = focus
            if action == MenuAction.toggle_mode : this.creative = !this.creative
            if action == MenuAction.back : this.open_worlds()
            if action == MenuAction.create {
                raylib.end_drawing()
                this.start_game(this.name_text, seed_from_text(this.seed_text), this.creative)
                return
            }
        }
        raylib.end_drawing()
        if raylib.is_key_pressed(.f2) {
            this.screenshots++
            raylib.take_screenshot("valkcraft-" + this.screenshots + ".png")
        }
        if (this.options.title || this.options.worlds) && this.options.screenshot.bytes > 0 && this.time > 1.5 {
            this.save_screenshot()
            this.quit = true
        }
    }

    // Keeps the selected world in the list's view
    fn scroll() uint {
        let visible = ((screen_height() - 140 - 70 - 8) / 68).to(uint)
        if visible == 0 || this.selected < visible : return 0
        return this.selected + 1 - visible
    }

    // Typing into the focused field of the new world screen
    fn type_text() {
        let text = this.focus == Field.name ? this.name_text : this.seed_text
        let ch = raylib.get_char_pressed()
        while ch > 0 {
            if ch >= 32 && ch < 127 && text.bytes < 32 {
                let buf = ByteBuffer.new(text.bytes + 1)
                buf.write(text)
                buf.write_byte(ch.to(u8))
                text = buf.to_string()
            }
            ch = raylib.get_char_pressed()
        }
        if (raylib.is_key_pressed(.backspace) || raylib.is_key_pressed_repeat(.backspace)) && text.bytes > 0 {
            text = text.range(0, text.bytes - 1)
        }
        if this.focus == Field.name : this.name_text = text
        else : this.seed_text = text
    }

    fn game_frame(game: Game, dt: f32) {
        let screen = this.screen
        if screen == Screen.playing {
            if this.settle > 0 {
                this.settle--
                raylib.get_mouse_delta()
            } else {
                game.player.look(raylib.get_mouse_delta())
            }
            game.handle_input(dt)
            if raylib.is_key_pressed(.escape) {
                this.save_game()
                this.go(Screen.paused)
            }
            else if raylib.is_key_pressed(.e) {
                game.craft_size = 2
                this.go(Screen.inventory)
            } else if game.wants_table {
                game.craft_size = 3
                this.go(Screen.inventory)
            }
            game.wants_table = false
            if raylib.is_key_pressed(.h) : this.show_help = !this.show_help
            if raylib.is_key_pressed(.f4) : game.set_creative(!game.creative)
        } else if screen == Screen.inventory {
            if raylib.is_key_pressed(.e) || raylib.is_key_pressed(.escape) {
                game.return_grid()
                game.craft_size = 2
                this.go(Screen.playing)
            }
        } else if screen == Screen.paused {
            if raylib.is_key_pressed(.escape) : this.go(Screen.playing)
        }
        // The click that opened a window (a right click on a crafting table) is not also a
        // click inside it
        if this.screen != screen {
            this.ui.clicked = false
            this.ui.right_clicked = false
        }
        // A paused game stands still
        if this.screen != Screen.paused : game.update(dt, this.screen == Screen.playing)
        if game.dead && this.screen != Screen.dead {
            game.return_grid()
            this.go(Screen.dead)
        }

        let camera = game.player.camera(70)
        raylib.begin_drawing()
        raylib.clear_background(sky_color())
        this.res.shader.set_vec3(this.res.view_location, camera.position)
        raylib.begin_mode_3d(camera)
        game.draw(this.res, camera)
        let view = (game.world.radius * CHUNK_SIZE).to(f32)
        this.clouds.draw(camera, this.time, view * 1.3)
        raylib.end_mode_3d()

        let screenshot = this.options.screenshot.bytes > 0
        draw_overlays(game, camera)
        if !screenshot || this.options.hud || this.options.inventory {
            draw_crosshair()
            draw_hotbar(this.ui, game)
            if !game.creative : draw_health(this.res, game)
            draw_info(game)
            draw_message(game)
            if this.show_help && this.screen == Screen.playing : draw_help(game.creative)
        }
        if this.screen == Screen.inventory {
            inventory_screen(this.ui, game)
        } else if this.screen == Screen.paused && screen == Screen.paused {
            let action = pause_screen(this.ui, game)
            if action == MenuAction.resume : this.go(Screen.playing)
            if action == MenuAction.toggle_mode : game.set_creative(!game.creative)
            if action == MenuAction.to_title {
                raylib.end_drawing()
                this.to_title()
                return
            }
        } else if this.screen == Screen.dead {
            let action = death_screen(this.ui, game)
            if action == MenuAction.respawn {
                game.respawn()
                this.go(Screen.playing)
            }
            if action == MenuAction.to_title {
                raylib.end_drawing()
                this.to_title()
                return
            }
        }
        raylib.end_drawing()
        if screenshot {
            this.save_screenshot()
            this.quit = true
        }
        if raylib.is_key_pressed(.f2) {
            this.screenshots++
            raylib.take_screenshot("valkcraft-" + this.screenshots + ".png")
        }
    }

    fn count_frame(dt: f32) {
        if this.options.frames <= 0 || this.screen != Screen.playing : return
        this.bench_frames++
        this.bench_time += dt
        if this.bench_frames >= this.options.frames {
            println(this.bench_frames + " frames, " + whole(this.bench_frames.to(f32) / this.bench_time) + " fps")
            this.quit = true
        }
    }

    fn save_screenshot() {
        let image = raylib.load_image_from_screen()
        raylib.export_image(image, this.options.screenshot)
        raylib.unload_image(image)
    }
}

fn sky_color() raylib.Color {
    return raylib.Color.rgb(142, 192, 238)
}

// A few stacks to start with (--kit)
fn give_kit(game: Game) {
    let kit = Array[Stack]{
        stack_of(Item.stone_pickaxe, 1), stack_of(Item.stone_axe, 1), stack_of(Item.stone_shovel, 1), stack_of(Item.iron_sword, 1)
        stack_of(Item.planks, 64), stack_of(Item.cobblestone, 64), stack_of(Item.log, 16), stack_of(Item.crafting_table, 1), stack_of(Item.porkchop, 8)
        stack_of(Item.stick, 12), stack_of(Item.iron_ingot, 6), stack_of(Item.glass, 32), stack_of(Item.brick, 32), stack_of(Item.wool, 16)
    }
    each kit as stack : game.inventory.add(stack)
}

fn main(args: Array[String]) {
    let options = parse_options(args)
    raylib.set_trace_log_level(.warning)
    raylib.set_config_flags(raylib.FLAG_MSAA_4X_HINT | raylib.FLAG_WINDOW_RESIZABLE | raylib.FLAG_VSYNC_HINT)
    raylib.init_window(options.width, options.height, "Valkcraft")
    defer raylib.close_window()
    raylib.set_exit_key(.none)

    let res = Resources.load()
    let app = App{ res: res, ui: Ui{ res: res }, options: options, clouds: Clouds{ noise: Noise.new(99) }, creative: options.creative, saves: saves_dir(options.saves) }
    if options.worlds : app.open_worlds()
    if options.play {
        let seed = options.seed
        app.start_game("New World", isset(seed) ? seed : seed_from_text(""), options.creative)
    }
    while !raylib.window_should_close() && !app.quit {
        let dt = raylib.get_frame_time()
        app.count_frame(dt)
        if dt > 0.05 : dt = 0.05
        app.frame(dt)
    }
    let game = app.game
    if isset(game) {
        // Closing the window saves too
        app.save_game()
        game.unload()
    }
    let panorama = app.panorama
    if isset(panorama) : panorama.unload()
}
