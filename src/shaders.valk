// The block shader: texture times the vertex light, fading into the sky with distance.
// Transparent texels (leaves, glass) are cut out. Texture coordinates are sampled at
// the centroid, so multisampling never reads the tile next door at an edge.

value BLOCK_VERTEX_SHADER ("#version 330
in vec3 vertexPosition;
in vec2 vertexTexCoord;
in vec4 vertexColor;
uniform mat4 mvp;
uniform mat4 matModel;
uniform vec3 viewPos;
centroid out vec2 fragTexCoord;
out vec4 fragColor;
out float fragDistance;
void main() {
    vec4 world = matModel * vec4(vertexPosition, 1.0);
    fragTexCoord = vertexTexCoord;
    fragColor = vertexColor;
    fragDistance = length(world.xz - viewPos.xz);
    gl_Position = mvp * vec4(vertexPosition, 1.0);
}
")

value BLOCK_FRAGMENT_SHADER ("#version 330
centroid in vec2 fragTexCoord;
in vec4 fragColor;
in float fragDistance;
uniform sampler2D texture0;
uniform vec4 colDiffuse;
uniform vec4 fogColor;
uniform float fogStart;
uniform float fogEnd;
out vec4 finalColor;
void main() {
    vec4 texel = texture(texture0, fragTexCoord);
    if (texel.a < 0.4) discard;
    vec4 color = texel * colDiffuse * fragColor;
    float fog = clamp((fragDistance - fogStart) / (fogEnd - fogStart), 0.0, 1.0);
    finalColor = vec4(mix(color.rgb, fogColor.rgb, fog), color.a);
}
")
