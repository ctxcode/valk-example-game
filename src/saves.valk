// Worlds on disk: one folder per world with `world.json` (name, seed, mode, the player,
// the inventory, items on the ground) and `chunks/`, the chunks the player changed. The
// rest of a world comes back from its seed.

use valk.fs
use valk.json
use valk.compress
use valk.time
use valk.core

value SAVE_VERSION (1)

class SavedStack {
    item: uint (0)
    count: uint (0)
    wear: uint (0)
}

class SavedDrop {
    item: uint (0)
    count: uint (0)
    wear: uint (0)
    x: f32 (0)
    y: f32 (0)
    z: f32 (0)
}

class WorldInfo {
    version: uint (SAVE_VERSION)
    name: String ("World")
    seed: uint (0)
    creative: bool (false)
    // Unix seconds
    created: int (0)
    played: int (0)
    x: f32 (0)
    y: f32 (0)
    z: f32 (0)
    yaw: f32 (0)
    pitch: f32 (0)
    health: f32 (20)
    flying: bool (false)
    selected: uint (0)
    spawn_x: f32 (0)
    spawn_y: f32 (0)
    spawn_z: f32 (0)
    inventory: Array[SavedStack] (.{})
    drops: Array[SavedDrop] (.{})
    // Set when listing: the folder it came from
    folder: String ("")
}

// Where worlds are kept: `--saves DIR`, or the user's data folder
fn saves_dir(chosen: String) String {
    if chosen.bytes > 0 : return chosen
    #if OS == "win"
    let base = core.getenv("APPDATA") !? (fs.home_dir() !? ".")
    return fs.add(fs.add(base, "Valkcraft"), "worlds")
    #elif OS == "macos"
    let home = fs.home_dir() !? "."
    return home + "/Library/Application Support/Valkcraft/worlds"
    #else
    let data = core.getenv("XDG_DATA_HOME") !? ""
    if data.bytes == 0 : data = (fs.home_dir() !? ".") + "/.local/share"
    return data + "/valkcraft/worlds"
    #end
}

fn make_dirs(path: String) {
    if fs.is_dir(path) : return
    let parent = fs.dir_of(path)
    if parent.bytes > 0 && parent != path : make_dirs(parent)
    fs.create_dir(path) _
}

// Every saved world, the last played first
fn list_worlds(dir: String) Array[WorldInfo] {
    let worlds = Array[WorldInfo]{}
    if !fs.is_dir(dir) : return worlds
    let names = fs.files_in(dir, false, false, true, true) ! return worlds
    each names as name {
        let folder = fs.add(dir, name)
        let text = fs.read(fs.add(folder, "world.json")) ! continue
        let info = json.decode_to[WorldInfo](text) ! continue
        info.folder = folder
        worlds.append(info)
    }
    worlds.sort(fn(a: WorldInfo, b: WorldInfo) bool {
        return a.played > b.played
    })
    return worlds
}

// A new folder for a world: its name in lowercase letters, digits and dashes, made unique
fn new_world_folder(dir: String, name: String) String {
    let buf = ByteBuffer.new(name.bytes + 8)
    let dash = false
    each name.lower() as ch {
        let keep = (ch >= 'a' && ch <= 'z') || (ch >= '0' && ch <= '9')
        if keep {
            if dash && buf.length > 0 : buf.write_byte('-')
            buf.write_byte(ch)
            dash = false
        } else {
            dash = true
        }
    }
    let base = buf.length > 0 ? buf.to_string() : "world"
    let folder = fs.add(dir, base)
    let n = 2
    while fs.exists(folder) {
        folder = fs.add(dir, base + "-" + n)
        n++
    }
    return folder
}

fn delete_world(folder: String) {
    fs.delete_all(folder) _
}

fn now_seconds() int {
    return (time.unix_ms() / 1000).to(int)
}

fn played_text(seconds: int) String {
    let moment = time.DateTime.from_unix_seconds(seconds) ! return ""
    let local = moment.in_zone(time.local_zone()) !? moment
    return local.format("Y-m-d H:i")
}

fn chunk_file(folder: String, cx: int, cz: int) String {
    return fs.add(fs.add(folder, "chunks"), cx + "." + cz + ".bin")
}

// The chunks a world has on disk, by their key
fn saved_chunks(folder: String) HashMap[int, bool] {
    let keys = HashMap[int, bool]{}
    let dir = fs.add(folder, "chunks")
    if !fs.is_dir(dir) : return keys
    let names = fs.files_in(dir, false, true, false, true) ! return keys
    each names as name {
        if !name.ends_with(".bin") : continue
        let parts = name.range(0, name.bytes - 4).split(".")
        if parts.length != 2 : continue
        let cx = parts[0].to(int) ! continue
        let cz = parts[1].to(int) ! continue
        keys.set(chunk_key(cx, cz), true)
    }
    return keys
}

// One byte per block, deflated
fn save_chunk(folder: String, chunk: Chunk) {
    let raw = ByteBuffer.new(CHUNK_VOLUME)
    each chunk.blocks as block : raw.write_byte(block.to(u8))
    make_dirs(fs.add(folder, "chunks"))
    fs.write(chunk_file(folder, chunk.cx, chunk.cz), compress.deflate(raw)) _
}

// Fills a chunk from disk; false when the file is missing or damaged
fn load_chunk(folder: String, chunk: Chunk) bool {
    let packed = fs.read(chunk_file(folder, chunk.cx, chunk.cz)) ! return false
    let raw = compress.inflate(packed, CHUNK_VOLUME) ! return false
    if raw.bytes != CHUNK_VOLUME : return false
    let blocks = all_blocks()
    each raw as id, i {
        let block = id.to(uint) < blocks.length ? blocks[id.to(uint)] : Block.air
        chunk.blocks[i] = block
        if block != Block.air {
            let y = (i / (CHUNK_SIZE * CHUNK_SIZE).to(uint)).to(int)
            if y > chunk.top : chunk.top = y
        }
    }
    return true
}

fn saved_stack(stack: Stack) SavedStack {
    return SavedStack{ item: stack.item.to(uint), count: stack.count.to(uint), wear: stack.wear.to(uint) }
}

fn loaded_stack(saved: SavedStack) Stack {
    let item = item_of(saved.item)
    if item == Item.none || saved.count == 0 : return Stack{}
    let count = saved.count > max_stack(item).to(uint) ? max_stack(item) : saved.count.to(u8)
    return Stack{ item: item, count: count, wear: saved.wear.to(u16) }
}

// The item with this number, or none
fn item_of(id: uint) Item {
    each all_items() as item {
        if item.to(uint) == id : return item
    }
    return Item.none
}
